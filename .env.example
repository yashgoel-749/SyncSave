# =================================================================
# SyncSpace Root Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER COMMIT ACTUAL SECRETS OR .env TO VERSION CONTROL
# =================================================================

# ── Database (Neon PostgreSQL) ──────────────────────────────────
# Pooled connection string (used by application runtime for fast queries)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true"

# Direct connection string (used by Prisma CLI for DDL migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Authentication (NextAuth.js & Collab Token Signing) ─────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Public URLs ─────────────────────────────────────────────────
# Next.js web application frontend URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WebSocket collaboration server endpoint (use wss:// in production)
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"

# ── Collaboration Server (apps/collab-server) ───────────────────
PORT="1234"
HOST="0.0.0.0"
NODE_ENV="development" # Set to "production" in production environments
LOG_LEVEL="info" # debug | info | warn | error

# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS="http://localhost:3000,https://syncspace.vercel.app"

# Connection and Rate Limiting Protection
MAX_CONNECTIONS="1000"
MAX_CONNECTIONS_PER_IP="50"
MESSAGE_RATE_LIMIT_PER_SEC="100"
MAX_PAYLOAD_BYTES="10485760" # 10 MB in bytes

# ── Optional OAuth Providers ────────────────────────────────────
# GitHub OAuth (SyncSpace functions fully with credentials auth without these)
# Obtain at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
