# =================================================================
# SyncSpace Root Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER COMMIT ACTUAL SECRETS OR .env TO VERSION CONTROL
# =================================================================

# Database (Neon PostgreSQL)
# Pooled connection string (used by application for queries)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true"

# Direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth / Auth.js Secret (generate via: openssl rand -base64 32 or npx auth secret)
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WebSocket Collaboration Server URL
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"

# Optional: GitHub OAuth (SyncSpace functions fully with credentials without these)
# Obtain at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Collaboration Server Settings (apps/collab-server)
PORT="1234"
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL="info"
