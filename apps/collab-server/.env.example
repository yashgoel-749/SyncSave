# =================================================================
# SyncSpace Collaboration Server (.env.example)
# Copy to .env or configure in hosting provider (e.g. Render)
# =================================================================

PORT=1234
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Secret key matching AUTH_SECRET in apps/web (must be >= 16 chars in production)
AUTH_SECRET=replace-with-a-random-32-byte-base64-secret

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,https://syncspace.vercel.app

# Reliability & DoS Protection
MAX_CONNECTIONS=1000
MAX_CONNECTIONS_PER_IP=50
MESSAGE_RATE_LIMIT_PER_SEC=100
MAX_PAYLOAD_BYTES=10485760
