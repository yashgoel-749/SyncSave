# =================================================================
# SyncSpace Web Frontend (.env.example)
# Copy to .env.local or configure in Vercel Dashboard
# =================================================================

# Neon PostgreSQL connection strings
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth.js Secret & Base URL
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WebSocket Collaboration Server URL (use wss:// in production)
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"

# Optional: GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
