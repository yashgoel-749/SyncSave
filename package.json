{
  "name": "syncspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:collab": "npm run dev --workspace=apps/collab-server",
    "build": "npm run db:generate && npm run build --workspace=apps/web",
    "build:collab": "npm run build --workspace=apps/collab-server",
    "build:all": "npm run db:generate && npm run build:collab && npm run build",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "prisma db push --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "^1.0.0"
  }
}
